#!/usr/bin/env python3
"""Writes Part VI (Economic Feasibility) of the ARA from the fiscal model.
Every number in the Part comes from fiscal_model.run(); nothing is typed by hand.
Output: out/part6.md and out/chart.json."""
import json, os, re
import sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import fiscal_model as fm

HERE = os.path.dirname(os.path.abspath(__file__))
OD = os.path.join(HERE, 'out')
res, scen, uni, sens, mc, base_tot = fm.run()
YEARS = fm.YEARS
CBO = list(range(2027, 2037))
tot = fm.tot


def dash(s):
    s = re.sub(r'(?<=\d)-(?=\d)', 'â€“', s)
    return s.replace('Behaviour', 'Behavior')


def b(x):           # table number, billions
    if 0 < abs(x) < 1: return f'{x:.1f}'
    x = round(x)
    return f'{x:,}'


def T(x, d=1):      # prose, trillions or billions with sign words handled by caller
    if abs(x) >= 1000:
        return f'${abs(x)/1000:.{d}f} trillion'
    return f'${abs(round(x)):,} billion'


def up(x, d=1):     # arrow form for prose/tables
    return ('â–² ' if x >= 0 else 'â–¼ ') + (f'${abs(x)/1000:.{d}f}T' if abs(x) >= 1000 else f'${abs(round(x)):,}B')


S = {k: dict(primary=tot(v['primary']), ds=tot(v['ds']), total=tot(v['total']),
             cbo=tot(v['total'], CBO), annual=v['total'], prim=v['primary'], dsy=v['ds'])
     for (n, c), v in scen.items() for k in [f'{n}_{c}']}
FC = S['full_central']; FV = S['full_favorable']; FX = S['full_conservative']; CC = S['core_central']
prim_u, ds_u = uni
uni_total = tot(prim_u) + tot(ds_u)
sens_d = dict(sens)
def SK(prefix): return next(v for k, v in sens if k.startswith(prefix))
FAIL = SK('Every uncertain'); BTD = SK('Billionaire tax: annual'); MEDX = SK('Medicare offsets')
GATE_REQ = mc['gate']['requested']; GATE_PAID = mc['gate']['paid']; GATE_DELAY = GATE_REQ - GATE_PAID
MED = None
def tbd_count():
    try:
        md = open(os.path.join(HERE, '..', 'out', 'PUB_ARA_RenewalAgenda_v4_2026.md')).read()
        p7 = md[md.index('# PART IX'):md.index('# PART X')]
        bt = []; inn = False
        for l in p7.split('\n'):
            s = l.strip()
            if s == '**Notes for counsel**': inn = True; continue
            if inn and (s.startswith('- ') or s == ''): continue
            inn = False; bt.append(l)
        return '\n'.join(bt).count('[TBD]')
    except Exception:
        return 324
g36 = fm.META['gdp_2036_trillions'] * 1000
g39 = g36 * 1.04 ** 3
pts36 = sum(FC['annual'][y] for y in fm.ALLY if y <= 2036) / g36 * 100
pts39 = sum(FC['annual'][y] for y in fm.ALLY if y <= 2039) / g39 * 100
ann39 = FC['annual'][2039]
R = {r['spec']['id']: r for r in res}
def C(i): return tot(R[i]['central'])
def L(i): return tot(R[i]['low'])
def H(i): return tot(R[i]['high'])

def cite(src):
    return ', '.join(str(s) for s in src) if src else 'â€”'

def row(r):
    s = r['spec']
    st = f"FY{s['start']} Â· {s['category']}"
    if s['block'] == 'zero': st = 'Not counted'
    name = f"**{s['proposal']}** Â· {s['label']}" if s['proposal'] != 'Several' else f"**Small items** Â· {s['label'].replace('Allowance for small items (listed below)', 'allowance (itemized below)')}"
    unc = s['uncertainty'] + (f" ({s['unc_detail']})" if s['block'] != 'zero' else '')
    return f"|{name}|{st}|{b(tot(r['low']))}|**{b(tot(r['central']))}**|{b(tot(r['high']))}|{dash(s['basis'])}|{cite(s['sources'])}|{dash(unc)}|"

HDR_C = '|What it costs â–²|Starts Â· type|Low|Central|High|How it is estimated|Sources|Uncertainty|\n|---|---|---|---|---|---|---|---|'
HDR_R = '|What pays for it â–¼|Starts Â· type|Low|Central|High|How it is estimated|Sources|Uncertainty|\n|---|---|---|---|---|---|---|---|'

def block_rows(side, blocks):
    rs = [r for r in res if r['spec']['side'] == side and r['spec']['block'] in blocks]
    return rs

core_c = block_rows('cost', ('core',)); bench_c = block_rows('cost', ('bench',))
rev = block_rows('revenue', ('core', 'zero'))
def sums(rs): return tuple(sum(tot(r[k]) for r in rs) for k in ('low', 'central', 'high'))
cc = sums(core_c); bc = sums(bench_c); rv = sums(rev)
MED = C('MAC') + C('SNP')
# pay-as-you-go reduction in each case = (costs - revenue) - primary
gate_c = (cc[1] + bc[1] - rv[1]) - FC['primary']
gate_f = (cc[0] + bc[0] - rv[2]) - FV['primary']
gate_x = (cc[2] + bc[2] - rv[0]) - FX['primary']

# ---------- chart data
groups = {}
for r in res:
    s = r['spec']
    if s['block'] in ('trust',): continue
    if s['side'] == 'cost':
        groups.setdefault(s['group'], 0.0); groups[s['group']] += tot(r['central'])
groups['Family and children'] -= gate_c
chart = [{'label': k, 'value': v, 'kind': 'cost'} for k, v in sorted(groups.items(), key=lambda kv: -kv[1])]
revs = [('Paid leave contribution', C('P93r')), ('Medicare payment accuracy', MED), ('Corporate rate to 23%', C('CORP')), ('Billionaire income tax (risk-weighted)', C('P5')),
        ('Wealth-loophole closures', C('P4')), ('IRS enforcement and Direct File', C('P1')), ('Public option savings', C('P19p')), ('Digital services levy', C('P5d'))]
for lab, v in sorted(revs, key=lambda kv: -kv[1]):
    chart.append({'label': lab, 'value': -v, 'kind': 'revenue'})
chart.append({'label': 'Net before interest', 'value': round(FC['primary'], 1), 'kind': 'net'})
chart.append({'label': 'Interest on added debt', 'value': round(FC['ds'], 1), 'kind': 'cost'})
chart.append({'label': 'Ten-year effect', 'value': round(FC['total'], 1), 'kind': 'total'})
json.dump(chart, open(os.path.join(OD, 'chart.json'), 'w'), indent=1)

# ---------- text
P = []
A = P.append
A('# PART VI â€” Economic Feasibility')
A('')
A('*The second test: the agenda must not only score well on its merits â€” it must be fiscally feasible and structurally durable.*')
A('')
A('-----')
A('')
A('## The Fiscal Case in Brief')
A('')
A(f"> **Colors and arrows used in this Part.** â–² Red marks a cost: it adds to the deficit. â–¼ Green marks revenue or savings: it reduces the deficit. Amounts are in billions of dollars over the ten fiscal years 2030â€“2039 unless stated otherwise.")
A('')
A('*Figure: the ten-year central case, FY2030â€“2039. Bars to the right add to the deficit; bars to the left reduce it. Costs are grouped by area; revenue lines are shown one by one.*')
A('')
A('<!-- FISCAL_CHART -->')
A('')
A(f"- **The answer.** The agenda adds about {T(FC['total'])} to federal deficits over ten years, interest included ({up(FC['total'])}). Costs actually paid, after the pay-as-you-go limit, total ${(cc[1]+bc[1]-gate_c)/1000:.2f} trillion; revenue and savings ${rv[1]/1000:.2f} trillion, leaving ${FC['primary']/1000:.2f} trillion before interest; interest on the added debt adds {T(FC['ds'])}.")
A(f"- **How sure.** A simulation that varies every line at once puts the likely range at {up(mc['p10'])} to {up(mc['p90'])} (80 percent of outcomes). Adding together every line's worst case gives {up(FX['total'])}; every line's best case gives {up(FV['total'])}.")
A(f"- **Against recent choices.** The 2025 tax law (Public Law 119-21) adds $4.1 trillion with interest, by CBO's count. Every one of the 20,000 simulated outcomes for this agenda falls below that, and even if every uncertain revenue line failed, the agenda would add {T(FAIL)}, because Phase II family spending slows when its revenue falls short.")
A(f"- **How it is paid for without cutting benefits.** The paid-leave contribution is set each year to cover the program, as Social Security's is. Ending Medicare Advantage overbilling and paying the same price for the same outpatient service save {T(MED)}, with rural hospitals exempt. A corporate rate of 23%, still well below the 35% in force before 2018, raises {T(C('CORP'))}. And the Phase II childcare expansion and children's accounts may spend only what the billionaire tax, loophole closures, and digital levy bring in each year; in the central case that delays about {T(GATE_DELAY)} of their cost past 2039 rather than borrowing it.")
A(f"- **Not deficit-neutral, and said so.** The yearly effect grows to about {T(ann39)} by 2039, about {ann39/g39*100:.1f}% of GDP, because family and health programs grow faster than the revenue that pays for them. Debt in 2039 would be about {pts39:.1f} points of GDP higher than under current law. The pay-as-you-go rule keeps the Phase II family programs from widening it; AIPE Fund returns and added Phase II revenue are the remaining levers.")
A(f"- **Social Security is separate.** The payroll tax on earnings above $250,000 raises about {T(C('S6'))} over the same years for the Social Security trust funds alone; it is not used to pay for anything in this ledger.")
A('')
A('')
A('### What This Review Is, and Is Not')
A('')
A('This is not an official score. Only the Congressional Budget Office (CBO) and the Joint Committee on Taxation (JCT) produce those, and they score bills, not platforms. This review follows their rules wherever a platform allows it, adds the disclosure practices of the leading independent fiscal institutions abroad, and shows every step, so that CBO â€” or any reader â€” can check it. Where a bill leaves an amount open, the review says what it assumed. When CBO or JCT score a bill in this agenda, their number replaces the one here.')
A('')
A('### The Fiscal Picture in November 2026')
A('')
A('- The federal deficit for FY2026 was **$1.99 trillion**, up $217 billion from FY2025, after $145 billion in tariff refunds that followed the Supreme Court\'s ruling on emergency tariffs [Source 923].')
A('- CBO projects federal debt held by the public rising from 100.6% of GDP in 2026 to **120.2% in 2036** under current law; tariff policy after the ruling adds $0.9 trillion to 2027â€“2036 deficits [Sources 800, 803, 922].')
A('- The 10-year Treasury yield reached about 5.2% in early October and was about **4.9%** after the November election, against the 4.3% average CBO assumes for 2026â€“2036 [Sources 829, 924, 922]. CBO estimates that rates 0.5 point higher than its path would add **$1.9 trillion** to deficits through 2036 and raise debt to 124.4% of GDP; 1.5 points higher would add $6.0 trillion [Source 922]. Interest rates are the largest single fiscal risk for any government in this period.')
A('- Social Security\'s 75-year gap grew to **4.42% of taxable payroll**; the retirement trust fund is projected to run short in late 2032 [Source 808].')
A('')
A('-----')
A('')
A('## How the Numbers Are Built')
A('')
A('Each rule below is the one an official or leading independent scorekeeper uses. The right-hand column names who.')
A('')
A('|Rule|What this review does|Who does it this way|')
A('|---|---|---|')
A('|Baseline|Measures every proposal against current law as CBO projects it: the February 2026 outlook, updated for tariffs in August 2026. The 2025 tax law counts as enacted, with its temporary provisions expiring on schedule.|CBO and JCT [Sources 800, 803]|')
A('|Ten-year window|FY2030â€“2039: the ten fiscal years after the Phase I bills, dated 2029, are enacted. That is the window CBO would use to score them. A FY2027â€“2036 view, matching CBO\'s current baseline, is also shown.|CBO; CRFB starts a platform\'s window when its policies take effect [Source 929]|')
A('|Timing|Year by year, never by fraction. Phase I takes effect in FY2030 and Phase II in FY2033, the dates written into its bills, with a half-year first year. Hiring, take-up, and construction ramp up. Phase III falls outside the window and is reported separately.|CBO; Australia\'s Parliamentary Budget Office [Source 934]|')
A('|What is counted|Conventional scoring: people\'s responses are counted (take-up, avoidance, state participation), but effects on the whole economy are not. Those are discussed separately.|CBO and JCT|')
A('|Budget category|Each line is labeled mandatory spending, revenue, or spending subject to appropriation. Appropriations are counted as if the authorized amount is provided.|CBO|')
A('|Older estimates|An older estimate is turned into a yearly amount at the middle of its own window, grown with the thing that drives it (wages, health costs, childcare costs, or capital income), and stripped of parts this agenda does not propose. The formula is printed at the end of this Part.|CBO practice; formula published here|')
A('|Overlapping revenue|Revenue lines are scored in a fixed order â€” enforcement, then loophole closures, then the billionaire income tax â€” each after the ones before it, so no dollar is counted twice.|JCT; CRFB|')
A('|Legal risk|Revenue with a real chance of being struck down is counted at a stated, probability-weighted value in the central case; the low case keeps only what the bill\'s own fallback would collect.|Rated as uncertainty, as the UK Office for Budget Responsibility does [Source 933]|')
A('|Pay-as-you-go|The Phase II childcare expansion and children\'s accounts are counted only up to the revenue the billionaire tax, loophole closures, and digital levy bring in each year, as FSW Act Sec. 5 requires.|CBO scores spending at the amount the law allows it to reach|')
A(f"|Interest|Computed year by year on the added debt at an assumed {fm.META['debt_rate']*100:.1f}%, with half a year of interest on each year\'s change. Rates 0.5 point higher and lower are tested.|CBO [Sources 805, 806, 922]|")
A('|Proposals without a score|Matched to the closest scored proposal and labeled as an analog. Small items are grouped in a stated allowance. Nothing with a known cost is left at zero.|CRFB [Source 929]|')
A('|Uncertainty|Every line is rated Low to Very high for its data, its model, and how people will respond, and a 20,000-draw simulation produces a likely range for the total.|UK Office for Budget Responsibility [Source 933]; CBO|')
A('|Disclosure|Every line carries its own costing note in the tables below. The model, its inputs, and a workbook are published with this document, so one command rebuilds every number.|Australia\'s PBO; OECD principles; Netherlands Bureau for Economic Policy Analysis [Sources 932, 934, 935]|')
A('')
A('Where credible estimates disagree, the central case takes the higher cost and the lower revenue. No single scorekeeper publishes all of these elements for a platform; this review combines them and publishes its working.')
A('')
A('-----')
A('')

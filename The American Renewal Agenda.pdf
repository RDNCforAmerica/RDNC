#!/usr/bin/env python3
"""ARA Fiscal Model.

Reads ara_fiscal_inputs.json and produces every number in Part VI:
year-by-year costs and revenues for FY2030-2039, debt service, scenario
totals, sensitivities and a Monte Carlo range. Run:  python3 fiscal_model.py
Outputs go to ./out (CSV, JSON, XLSX). Amounts are billions of nominal dollars.
Sign convention in outputs: a positive number ADDS to the deficit.
"""
import json, copy, csv, os, math
import numpy as np
from scipy.stats import norm

HERE = os.path.dirname(os.path.abspath(__file__))
INP = json.load(open(os.path.join(HERE, 'ara_fiscal_inputs.json')))
META = INP['meta']
Y0, Y1 = META['window']
YEARS = list(range(Y0, Y1 + 1))
ALLY = list(range(2027, Y1 + 1))        # covers the CBO-comparable view too


def growth_rate(g):
    return META['growth'][g] if isinstance(g, str) else float(g)


def ramp_vector(spec, start, end):
    """Share of steady state in each year (0-1)."""
    r = spec.get('ramp', [])
    v = {}
    for y in ALLY:
        if y < start or y > end:
            v[y] = 0.0; continue
        k = y - start
        if r == 'linear10':
            v[y] = min(1.0, (k + 1) / 10)
        else:
            v[y] = r[k] if k < len(r) else 1.0
    return v


def profile(spec):
    """Year-by-year amounts (positive = size of the cost or revenue)."""
    start = spec['start']; end = spec.get('end', Y1)
    rv = ramp_vector(spec, start, end)
    m = spec['method']
    out = {y: 0.0 for y in ALLY}
    if m == 'total':
        # distribute a stated window total over the active years
        g = growth_rate(spec.get('growth', 0.0)) if spec.get('shape') == 'ramp_growth' else 0.0
        w = {y: rv[y] * (1 + g) ** (y - start) for y in ALLY}
        win = [y for y in YEARS if start <= y <= end]
        s = sum(w[y] for y in win)
        for y in ALLY:
            out[y] = spec['total'] * w[y] / s if s else 0.0
        return out
    fac = 1.0
    for f in spec.get('factors', []):
        fac *= f[0]
    g = growth_rate(spec['growth'])
    if m == 'uprate':
        a, b = spec['src_years']
        n = b - a + 1
        mid = (a + b) / 2
        base = spec['src_total'] / n * fac          # annual value at source midpoint
        ref = mid
    else:  # 'annual'
        base = spec['annual'] * fac
        ref = spec['base_year']
    for y in ALLY:
        out[y] = base * (1 + g) ** (y - ref) * rv[y]
    for yr, amt in spec.get('lump', []):
        out[yr] += amt
    return out


def variant(spec, which):
    """Return the low or high profile."""
    v = spec[which]
    if isinstance(v, dict):
        s = copy.deepcopy(spec); s.update(v)
        return profile(s)
    p = profile(spec)
    return {y: p[y] * v for y in p}


def signed(spec, prof):
    sgn = 1 if spec['side'] == 'cost' else -1
    return {y: sgn * prof[y] for y in prof}


def debt_service(deficit, rate):
    """CBO-style: interest on the cumulative change in debt, with half a year
    of interest on the current year's change; interest compounds."""
    debt = 0.0; ds = {}
    for y in ALLY:
        d = deficit.get(y, 0.0)
        ds[y] = rate * (debt + 0.5 * d)
        debt += d + ds[y]
    return ds


def tot(d, yrs=YEARS):
    return sum(d.get(y, 0.0) for y in yrs)


def run():
    lines = INP['lines']
    res = []
    for s in lines:
        c = profile(s); lo = variant(s, 'low'); hi = variant(s, 'high')
        res.append(dict(spec=s, central=c, low=lo, high=hi))
    ix = {r['spec']['id']: k for k, r in enumerate(res)}
    arr = lambda d: np.array([d[y] for y in ALLY])

    def stream(profs, blocks):
        """Signed deficit stream (numpy, years along the last axis) from unsigned
        line profiles. Pay-as-you-go gate: in each year, lines marked 'gated' may
        cost no more than the revenue from lines marked 'gating' (FSW Act Sec. 5)."""
        tot_ = 0.0; g_cost = 0.0; g_rev = 0.0
        for r in res:
            s = r['spec']
            if s['block'] not in blocks: continue
            p = profs[s['id']]
            if s.get('gated'):
                g_cost = g_cost + p; continue
            if s.get('gating'): g_rev = g_rev + p
            tot_ = tot_ + (p if s['side'] == 'cost' else -p)
        if not isinstance(g_cost, float) or g_cost != 0.0:
            tot_ = tot_ + np.minimum(g_cost, g_rev)
        return tot_

    def case_profs(case):
        out = {}
        for r in res:
            s = r['spec']
            if case == 'central': p = r['central']
            elif case == 'conservative': p = r['high'] if s['side'] == 'cost' else r['low']
            else: p = r['low'] if s['side'] == 'cost' else r['high']
            out[s['id']] = arr(p)
        return out

    def as_dict(a): return {y: float(a[i]) for i, y in enumerate(ALLY)}
    rate = META['debt_rate']
    FULL = ('core', 'zero', 'bench')
    scen = {}
    for name, blocks in (('core', ('core', 'zero')), ('full', FULL)):
        for case in ('favorable', 'central', 'conservative'):
            prim = as_dict(stream(case_profs(case), blocks))
            ds = debt_service(prim, rate)
            scen[(name, case)] = dict(primary=prim, ds=ds, total={y: prim[y] + ds[y] for y in ALLY})
    # gated spending actually paid in the central case
    cp = case_profs('central')
    gc = sum(cp[r['spec']['id']] for r in res if r['spec'].get('gated'))
    gr = sum(cp[r['spec']['id']] for r in res if r['spec'].get('gating'))
    gate_info = dict(requested=float(sum(gc[[ALLY.index(y) for y in YEARS]])),
                     paid=float(sum(np.minimum(gc, gr)[[ALLY.index(y) for y in YEARS]])))

    prim_u = as_dict(stream(cp, FULL + ('trust',)))
    ds_u = debt_service(prim_u, rate)

    base_prim = scen[('full', 'central')]['primary']
    base_tot = tot(base_prim) + tot(debt_service(base_prim, rate))
    def total_with(profs, r=rate):
        prim = as_dict(stream(profs, FULL)); return tot(prim) + tot(debt_service(prim, r))
    def alt(**changes):
        p = case_profs('central'); p.update(changes); return p
    sens = []
    sens.append(('Interest rates 0.5 point higher than assumed', total_with(cp, rate + META['rate_shock'])))
    sens.append(('Interest rates 0.5 point lower than assumed', total_with(cp, rate - META['rate_shock'])))
    sens.append(('Interest at today\'s 10-year Treasury yield (4.9%) throughout', total_with(cp, 0.049)))
    sens.append(('Billionaire tax: annual mark-to-market struck down, fallback applies', total_with(alt(P5=arr(R_(res, 'P5')['low'])))))
    sens.append(('Billionaire tax: upheld in full at a higher rate', total_with(alt(P5=arr(R_(res, 'P5')['high'])))))
    zero = np.zeros(len(ALLY))
    sens.append(('Every uncertain revenue line fails (IRS, loopholes, billionaire tax, digital levy, public option)',
                 total_with(alt(P1=zero, P4=zero, P5=zero, P5d=zero, P19p=zero))))
    sens.append(('Medicare offsets not enacted', total_with(alt(MAC=zero, SNP=zero))))
    sens.append(('Corporate rate set at 22% instead of 23%', total_with(alt(CORP=arr(R_(res, 'CORP')['central']) * 0.5))))
    def shifted(k):
        p = case_profs('central')
        for r in res:
            s = r['spec']
            if s['phase'] != 'II': continue
            ss = copy.deepcopy(s); ss['start'] = s['start'] + k
            if 'lump' in ss: ss['lump'] = [[a + k, b] for a, b in ss['lump']]
            p[s['id']] = arr(profile(ss))
        return p
    sens.append(('Phase II takes effect two years later (FY2035)', total_with(shifted(2))))
    pn = case_profs('central')
    for r in res:
        if r['spec']['phase'] == 'II': pn[r['spec']['id']] = zero
    sens.append(('Phase II is never enacted', total_with(pn)))
    for k, lab in ((1.25, 'higher'), (0.75, 'lower')):
        p = case_profs('central')
        for r in res:
            if r['spec'].get('mc_group') == 'take_up': p[r['spec']['id']] = p[r['spec']['id']] * k
        sens.append((f'Family-program take-up 25% {lab}', total_with(p)))
    sens.append(('IRS enforcement at the high (deterrence-inclusive) estimate', total_with(alt(P1=arr(R_(res, 'P1')['high'])))))

    # ---------- Monte Carlo
    rng = np.random.default_rng(META['mc_seed'])
    N = META['mc_draws']
    groups = META['mc_groups']
    common = {g: rng.standard_normal(N) for g in groups}
    draws = {}
    for r in res:
        s = r['spec']
        g = s.get('mc_group')
        z = (math.sqrt(groups[g]) * common[g] + math.sqrt(1 - groups[g]) * rng.standard_normal(N)) if g else rng.standard_normal(N)
        u = norm.cdf(z)
        c = tot(r['central']); lo = tot(r['low']); hi = tot(r['high'])
        a, m, b = min(lo, c, hi), c, max(lo, c, hi)
        if b - a < 1e-9: draw = np.full(N, c)
        else:
            fc = (m - a) / (b - a)
            draw = np.where(u < fc, a + np.sqrt(u * (b - a) * (m - a)), b - np.sqrt((1 - u) * (b - a) * (b - m)))
        if c == 0:
            ht = tot(r['high'])
            draws[s['id']] = np.outer(draw / ht if ht else np.zeros(N), arr(r['high']))
        else:
            draws[s['id']] = np.outer(draw / c, arr(r['central']))
    sims = stream(draws, FULL)
    debt = np.zeros(N); dsum = np.zeros(N); prim_win = np.zeros(N)
    for j, y in enumerate(ALLY):
        d = sims[:, j]; ds = rate * (debt + 0.5 * d); debt += d + ds
        if y in YEARS: dsum += ds; prim_win += d
    mc_tot = prim_win + dsum
    mc = {f'p{p}': float(np.percentile(mc_tot, p)) for p in (5, 10, 25, 50, 75, 90, 95)}
    mc['mean'] = float(mc_tot.mean())
    mc['share_below_PL119_21'] = float((mc_tot < 4100).mean())
    mc['gate'] = gate_info
    return res, scen, (prim_u, ds_u), sens, mc, base_tot


def R_(res, i):
    return next(r for r in res if r['spec']['id'] == i)


def main():
    res, scen, uni, sens, mc, base_tot = run()
    od = os.path.join(HERE, 'out'); os.makedirs(od, exist_ok=True)
    cbo = list(range(2027, 2037))
    # line ledger
    rows = []
    for r in res:
        s = r['spec']
        rows.append(dict(id=s['id'], proposal=s['proposal'], label=s['label'], block=s['block'], side=s['side'],
                         category=s['category'], phase=s['phase'], group=s['group'],
                         low=round(tot(r['low']), 1), central=round(tot(r['central']), 1), high=round(tot(r['high']), 1),
                         central_cbo_window=round(tot(r['central'], cbo), 1),
                         uncertainty=s['uncertainty'], unc_detail=s['unc_detail'],
                         sources=';'.join(str(x) for x in s['sources']), basis=s['basis']))
    with open(os.path.join(od, 'ledger.csv'), 'w', newline='') as f:
        w = csv.DictWriter(f, fieldnames=list(rows[0].keys())); w.writeheader(); w.writerows(rows)
    with open(os.path.join(od, 'annual_central.csv'), 'w', newline='') as f:
        w = csv.writer(f); w.writerow(['id', 'side'] + YEARS)
        for r in res:
            w.writerow([r['spec']['id'], r['spec']['side']] + [round(r['central'][y], 2) for y in YEARS])
    summ = {}
    for (name, case), v in scen.items():
        summ[f'{name}_{case}'] = dict(primary=round(tot(v['primary']), 1), debt_service=round(tot(v['ds']), 1),
                                     total=round(tot(v['total']), 1),
                                     total_cbo_window=round(tot(v['total'], cbo), 1),
                                     cum_debt_2036=round(sum(v['total'][y] for y in ALLY if y <= 2036), 1),
                                     cum_debt_2039=round(sum(v['total'][y] for y in ALLY if y <= 2039), 1),
                                     annual_total={y: round(v['total'][y], 1) for y in YEARS})
    prim_u, ds_u = uni
    summ['unified_with_S6_central'] = dict(primary=round(tot(prim_u), 1), debt_service=round(tot(ds_u), 1),
                                           total=round(tot(prim_u) + tot(ds_u), 1))
    summ['sensitivities'] = [(k, round(v, 1)) for k, v in sens]
    summ['base_total'] = round(base_tot, 1)
    summ['monte_carlo'] = {k: (v if isinstance(v, dict) else round(v, 3 if k.startswith('share') else 1)) for k, v in mc.items()}
    g36 = META['gdp_2036_trillions'] * 1000
    g39 = g36 * 1.04 ** 3
    summ['debt_gdp_points'] = dict(
        y2036=round(summ['full_central']['cum_debt_2036'] / g36 * 100, 2),
        y2039=round(summ['full_central']['cum_debt_2039'] / g39 * 100, 2))
    json.dump(summ, open(os.path.join(od, 'summary.json'), 'w'), indent=1)
    # workbook
    try:
        from openpyxl import Workbook
        wb = Workbook(); ws = wb.active; ws.title = 'Ledger'
        ws.append(list(rows[0].keys()))
        for r in rows: ws.append(list(r.values()))
        ws2 = wb.create_sheet('Annual (central)'); ws2.append(['id', 'side'] + YEARS)
        for r in res: ws2.append([r['spec']['id'], r['spec']['side']] + [round(r['central'][y], 2) for y in YEARS])
        ws3 = wb.create_sheet('Scenarios'); ws3.append(['scenario', 'primary', 'debt_service', 'total', 'total_FY2027_2036'])
        for k, v in summ.items():
            if isinstance(v, dict) and 'primary' in v:
                ws3.append([k, v['primary'], v['debt_service'], v['total'], v.get('total_cbo_window')])
        ws4 = wb.create_sheet('Sensitivities'); ws4.append(['case', 'total incl. debt service'])
        for k, v in summ['sensitivities']: ws4.append([k, v])
        ws5 = wb.create_sheet('Assumptions'); ws5.append(['key', 'value'])
        for k, v in META.items(): ws5.append([k, json.dumps(v)])
        wb.save(os.path.join(od, 'ARA_FiscalModel_2026.xlsx'))
    except ImportError:
        pass
    print(json.dumps({k: {kk: vv for kk, vv in summ[k].items() if kk != 'annual_total'} for k in ('core_central', 'full_central', 'full_favorable', 'full_conservative', 'unified_with_S6_central', 'monte_carlo', 'debt_gdp_points')}, indent=1, default=str))
    for k, v in summ['sensitivities']: print(f'{v:9.1f}  {k}')
    for r in rows: print(f"{r['id']:6} {r['side']:7} {r['low']:8.1f} {r['central']:8.1f} {r['high']:8.1f}  cbo:{r['central_cbo_window']:7.1f}")


if __name__ == '__main__':
    main()

endstream
